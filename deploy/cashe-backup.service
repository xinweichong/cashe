[Unit]
Description=Cashe encrypted backup upload
# Do not let a stuck run block the next scheduled attempt indefinitely.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=xinweichong
WorkingDirectory=/home/xinweichong/cashe
# R2_ENDPOINT_URL and R2_BACKUP_BUCKET live here, mode 0600, not in git.
EnvironmentFile=/etc/cashe/backup.env
ExecStart=/home/xinweichong/cashe/venv/bin/python -m scripts.backup upload \
    --key-file /secure/cashe-backup.key \
    --data-dir /home/xinweichong/cashe/data \
    --config /home/xinweichong/cashe/config.yaml \
    --credentials /home/xinweichong/cashe/credentials.json
# Keep a single job execution: systemd will not start a new run of this
# unit while a previous one is still active (Type=oneshot default).
TimeoutStartSec=600
