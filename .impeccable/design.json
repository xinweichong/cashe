 "narrative": {
  "northStar": "The Spectrum Wallet",
  "overview": "Calm, native and exact: an iOS-feeling money app where grouped lists carry the facts and colour is rationed to one spectrum card and the data itself. Structure and behaviour follow Apple's HIG; the look is cashe's own.",
  "keyCharacteristics": [
   "One spectrum card per screen, top of Home/Plan/Explore only",
   "Square rows inside 18px groups; 12px teal inset selection on md+",
   "Frosted chrome with solid fallbacks",
   "Plus Jakarta names, Inter speaks, JetBrains Mono counts money",
   "44pt touch rows, 36pt pointer rows, a pressed state on everything tappable"
  ],
  "rules": [
   "The One Spectrum Card Rule",
   "The Spectrum-Not-Stoplight Rule",
   "The No-Eyebrow Rule",
   "The Material-Has-A-Reason Rule"
  ],
  "dos": [
   "Compose ListGroup/ListRow, PageCard, NavBar, Toolbar, TaskSheet and ListDetail",
   "Route every amount through the money formatter",
   "Verify at 200% text, Reduce Motion and both themes"
  ],
  "donts": [
   "Glow shadows, gradient text or a second spectrum card",
   "Mono uppercase eyebrows above headings",
   "Bordered or nested cards where a grouped list fits",
   "Swipe-only actions",
   "Blur where nothing scrolls beneath"
  ]
 }
